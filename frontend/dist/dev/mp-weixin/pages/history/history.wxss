.container{min-height:100vh;background-color:#f8fafc;-webkit-box-sizing:border-box;box-sizing:border-box;padding-top:calc(180rpx + constant(safe-area-inset-top));padding-top:calc(180rpx + env(safe-area-inset-top));padding-bottom:calc(120rpx + constant(safe-area-inset-bottom));padding-bottom:calc(120rpx + env(safe-area-inset-bottom))}.main{max-width:750rpx;margin:0 auto;padding:30rpx;-webkit-box-sizing:border-box;box-sizing:border-box}.history-card{background-color:#fff;border-radius:40rpx;padding:40rpx;-webkit-box-shadow:0 4rpx 12rpx rgba(0,0,0,.05);box-shadow:0 4rpx 12rpx rgba(0,0,0,.05);-webkit-box-sizing:border-box;box-sizing:border-box}.title{font-size:36rpx;font-weight:500;color:#1f2937;text-align:center;margin-bottom:40rpx;display:block}.history-list{-webkit-box-sizing:border-box;box-sizing:border-box}.empty-tip{text-align:center;color:#94a3b8;padding:40rpx 0;font-size:28rpx}.history-item{padding:20rpx 0}.event-row{display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-pack:justify;-ms-flex-pack:justify;justify-content:space-between;padding:10rpx 0}.event-info{display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-flex:1;-ms-flex:1;flex:1;min-width:0}.icon-wrapper{width:80rpx;height:80rpx;background-color:#dbeafe;border-radius:40rpx;display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-pack:center;-ms-flex-pack:center;justify-content:center;-ms-flex-negative:0;flex-shrink:0;margin-right:20rpx}.icon{font-size:40rpx;color:#3b82f6}.event-text{font-size:28rpx;color:#374151;-webkit-box-flex:1;-ms-flex:1;flex:1;min-width:0;margin-right:20rpx;word-break:break-all}.date-text{font-size:24rpx;color:#94a3b8;-ms-flex-negative:0;flex-shrink:0;min-width:80rpx;text-align:right}.divider{height:2rpx;background-color:#f1f5f9;margin:20rpx 0}
